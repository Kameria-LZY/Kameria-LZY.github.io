@mastersthesis{yang2026coolness,
  selected={true},
  title = {Coolness and Distinction: A24 and American Indie Film Since 2010},
  author = {Zili Yang},
  year = {2026},
  school = {Xiamen University},
  journal = {M.A. thesis, Xiamen University},
  abstract = {Asks how A24 achieved both economic success and cultural influence, and what that success reveals about broader changes in the indie film industry and culture. Reading A24 through Christensen's corporate author, Bourdieu's sociology of taste, and brand economics, the thesis traces the history of cool culture and A24's brand strategy, then compares A24 with Miramax and Neon.},
  description={M.A. thesis arguing that A24's success stems largely from its use of networked media, taste culture and brand strategy in response to an emerging youth culture — generating a new form of cinephilia organized around "cool," brand loyalty and identity rather than directorial aesthetics.},
  keywords={A24, American Independent Cinema, Bourdieu, Brand Strategy, Cinephilia}
}

@article{yang2024motherdaughter,
  selected={true},
  title = {Recurrent Mother-Daughter Conflicts: Archetypal Narratives, Immigrant Subjectivities and Ideological Mechanisms in Chinese American Cinema},
  author = {Zili Yang},
  year = {2024},
  journal = {Independent research project, Critical Media Theory},
  abstract = {Asks why the mother-daughter conflict has been reproduced so persistently by different filmmakers across different historical periods. Following Northrop Frye, the paper traces the narrative back to the myth of Demeter and Persephone and reads its recurrence as a manifestation of the collective unconscious, then examines the pattern through three lenses: the immigrant experience, commerce, and ideology.},
  description={Traces a recurring narrative in Chinese American cinema to its archetypal roots, then argues that the pattern has become increasingly privatized — detaching protagonists from the broader social landscape and turning Asian American identity into generic spectacle.},
  keywords={Asian American Cinema, Archetype, Immigration, Ideology}
}

@mastersthesis{yang2022chuzou,
  selected={true},
  title = {Chuzou (Asian Women in Departure): Female Identity and Cultural Negotiation in Wayne Wang's Films},
  author = {Zili Yang},
  year = {2022},
  school = {Huaqiao University},
  journal = {B.A. thesis, Huaqiao University},
  abstract = {Uses the Chinese critical concept of "chuzou" — departure, but also the power of women who resist oppression — as the central framework for reading female identity and cultural negotiation in Wayne Wang's films, alongside postcolonial perspectives.},
  description={B.A. thesis arguing that two generations of Asian American women in Wang's films depart from their homes in pursuit of their own subjectivities, opening possibilities that the earlier "Dragon Lady" stereotype foreclosed.},
  keywords={Wayne Wang, Asian American Cinema, Postcolonialism, Gender}
}
